<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lunflux.hyper-meta-ai.briefing-refresh</string>
		<string>com.lunflux.hyper-meta-ai.task-inspect</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Hyper Meta AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Hyper Meta AI</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hypermetaai</string>
				<string>turbometa</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fb-viewapp</string>
	</array>
	<key>MWDAT</key>
	<dict>
		<key>AppLinkURLScheme</key>
		<string>hypermetaai://</string>
		<key>MetaAppID</key>
		<string>$(META_APP_ID)</string>
		<key>TeamID</key>
		<string>$(DEVELOPMENT_TEAM)</string>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Needed to connect to Meta AI Glasses</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Hyper Meta AI 需要访问日历，以便为你创建日程（如“把明天的会议加入日历”）并查询安排。</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Hyper Meta AI needs calendar access to create and read your schedule.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Hyper Meta AI 需要读取健康数据（步数 / 体重 / 睡眠），以便向你汇报每日健康概况。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Hyper Meta AI 需要写入健康数据（体重 / 步数 / 跑步），以便记录你口述的健康信息。</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Hyper Meta AI 需要访问您的家庭数据，以便通过语音或眼镜控制家中的智能设备（灯、空调、开关等）。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Hyper Meta AI 需要访问本地网络，以连接自建 RTMP 直播服务器与局域网内的 Agent 网关。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Hyper Meta AI 需要访问麦克风以实现与智能眼镜的实时语音对话功能。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Hyper Meta AI 需要访问相册以保存从智能眼镜拍摄的照片。</string>
	<key>NSSiriUsageDescription</key>
	<string>Hyper Meta AI 需要 Siri 权限以支持语音快捷指令触发快速识图功能。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Hyper Meta AI 使用设备端语音识别监听「你好千问」唤醒词，无需联网即可唤醒语音助手。</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>external-accessory</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.meta.ar.wearable</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
